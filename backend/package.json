{
  "name": "@vibefusion/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VibeFusion AI shared API (modular monolith)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "ingest": "tsx src/ingestion/cli.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "contracts:validate": "tsx scripts/validate-contracts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
