# Copy to .env (never commit real secrets). All values optional for local dev.
PORT=8080
# Leave unset to use embedded PGlite (./.data/pglite). Set for real PostgreSQL:
# DATABASE_URL=postgres://vibefusion:vibefusion@localhost:5432/vibefusion
JWT_SECRET=change-me-in-dev-only
MEDIA_SIGNING_SECRET=change-me-too
PUBLIC_BASE_URL=http://localhost:8080
# Optional: enables the Anthropic LLM planner; without it the deterministic rule-based planner is used.
# ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
# Pull free/open content (Internet Archive CC netlabels, LibriVox public domain, podcast RSS) on first start.
INGEST_ON_START=true
SYNTHETIC_CATALOGUE=true
ADMIN_EMAILS=admin@vibefusion.local
