{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibefusion.app/schemas/fusion-request.v1.json",
  "title": "Fusion plan request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "targetDurationMs"],
  "properties": {
    "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "targetDurationMs": { "type": "integer", "minimum": 10000, "maximum": 7200000 },
    "mood": { "type": "string", "maxLength": 40 },
    "energyCurve": { "enum": ["steady", "gradual_build", "wind_down", "peak_middle"] },
    "genres": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 40 } },
    "includeSpeech": { "type": "boolean" },
    "speechTopic": { "type": "string", "maxLength": 40 },
    "speechLanguage": { "type": "string", "maxLength": 8 },
    "availableAssetIds": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 64 } },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLayers": { "type": "integer", "minimum": 1, "maximum": 8 },
        "allowLoops": { "type": "boolean" },
        "allowStemMixing": { "type": "boolean" },
        "allowRenderedExport": { "type": "boolean" }
      }
    }
  }
}
